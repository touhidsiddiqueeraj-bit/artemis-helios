  (text "HELIOS-ARTEMIS MPPT -- Component Map\nConnect nets by matching labels.\nImport footprints via Tools > Update PCB from Schematic after wiring."
    (at 10 10 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid "b1000030-0000-0000-0000-000000000001")
  )
  (text "Power Path: J1(PV_IN) -- F1(5A) -- R1(0R1 shunt) -- C2(1000uF bulk) -- [Q1 MOSFET] -- L1(100uH) -- C1(470uF) -- J2(BAT_OUT)"
    (at 10 15 0)
    (effects (font (size 1.2 1.2)) (justify left))
    (uuid "b1000030-0000-0000-0000-000000000002")
  )
  (text "Gate Drive: STM32 PA8 -> PWM_50K label -> TC4420 IN -> R4(10R at OUT) -> GATE label -> Q1 gate"
    (at 10 18 0)
    (effects (font (size 1.2 1.2)) (justify left))
    (uuid "b1000030-0000-0000-0000-000000000003")
  )
  (text "I2C: SDA/SCL labels shared by INA219(addr 0x40) GY302(addr 0x23) ESP32 GPIO21/22 STM32 PB6/PB7 -- R2 R3 4k7 pull to +3.3V"
    (at 10 21 0)
    (effects (font (size 1.2 1.2)) (justify left))
    (uuid "b1000030-0000-0000-0000-000000000004")
  )
  (text "UART: UART_TX = ESP32 GPIO17 to STM32 PA10 at 115200 baud -- V_MPP prediction every 100ms"
    (at 10 24 0)
    (effects (font (size 1.2 1.2)) (justify left))
    (uuid "b1000030-0000-0000-0000-000000000005")
  )
  (text "SPI SD: SPI_MOSI=GPIO23 SPI_MISO=GPIO19 SPI_SCK=GPIO18 SPI_CS=GPIO5 -- J3 SD module"
    (at 10 27 0)
    (effects (font (size 1.2 1.2)) (justify left))
    (uuid "b1000030-0000-0000-0000-000000000006")
  )
  (text "Kelvin shunt: SHUNT_P and SHUNT_N sense labels connect ONLY to INA219 IN+ IN- pins -- never to power pour"
    (at 10 30 0)
    (effects (font (size 1.2 1.2)) (justify left))
    (uuid "b1000030-0000-0000-0000-000000000007")
  )
  (text "CC/CV FSM: Bulk CC 6A to 14.7V -- Absorption CV 14.7V to 0.5A tail -- Float 13.8V"
    (at 10 33 0)
    (effects (font (size 1.2 1.2)) (justify left))
    (uuid "b1000030-0000-0000-0000-000000000008")
  )
  (text "Blend law: V_ref = (1-alpha)*P&O + alpha*LSTM  alpha=0.35  fires when deltaG/G > 0.15"
    (at 10 36 0)
    (effects (font (size 1.2 1.2)) (justify left))
    (uuid "b1000030-0000-0000-0000-000000000009")
  )
  (text "ICs needing footprints from KiCad libs:\nU1 ESP32-S3 DevKit-C -- RF_Module:ESP32-S3-WROOM-1\nU2 STM32F103C8T6 -- MCU_ST_STM32F1:STM32F103C8Tx  LQFP-48\nU3 INA219 -- Sensor_Current:INA219xBx  SOIC-8\nU4 TC4420 -- Driver_FET:TC4420  SO-8\nU5 AMS1117-3.3 -- Regulator_Linear:AMS1117-3.3  SOT-223\nU6 GY302 -- Sensor_Optical:BH1750  DFN-6\nQ1 IRFB4110 -- Transistor_FET:IRLB8721PbF  TO-220 sub\nD1 SS34 -- Device:D_Schottky  D_SMA"
    (at 10 100 0)
    (effects (font (size 1.2 1.2)) (justify left))
